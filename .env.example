# Copie este archivo como .env y complete los valores locales.
SECRET_KEY=cambie-esto-por-una-clave-larga-aleatoria
# Opción recomendada: credenciales SQL separadas (soporta cualquier carácter en la contraseña).
DB_SERVER=192.168.10.101
DB_PORT=1433
DB_NAME=ReportesMantencion
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
DB_DRIVER=ODBC Driver 18 for SQL Server
# Alternativa avanzada: una sola URL. Déjela vacía si usa las variables DB_*.
DATABASE_URL=
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=26214400
ADMIN_USERNAME=admin@empresa.cl
ADMIN_PASSWORD=CambieEstaClaveAntesDeProduccion
SESSION_COOKIE_SECURE=false
