# Copie este archivo como .env y complete los valores locales.
SECRET_KEY=cambie-esto-por-una-clave-larga-aleatoria
# Opción recomendada: credenciales SQL separadas (soporta cualquier carácter en la contraseña).
DB_SERVER=192.168.10.101
DB_PORT=1433
DB_NAME=ReportesMantencion
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql
DB_DRIVER=ODBC Driver 18 for SQL Server
# Local: no/yes. Azure SQL: yes/no.
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
# Alternativa avanzada: una sola URL. Déjela vacía si usa las variables DB_*.
DATABASE_URL=
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=26214400
# Archivos: local para desarrollo; azure_blob para Render/producción.
FILE_STORAGE_BACKEND=local
# Solo con FILE_STORAGE_BACKEND=azure_blob. Mantenga la cadena real fuera de Git.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=reportes-adjuntos
ADMIN_USERNAME=admin@empresa.cl
ADMIN_PASSWORD=CambieEstaClaveAntesDeProduccion
SESSION_COOKIE_SECURE=false
# API móvil: en producción use un secreto distinto, aleatorio y de al menos 32 bytes.
API_TOKEN_SECRET=cambie-por-otro-secreto-largo-aleatorio
API_TOKEN_ISSUER=reportes-mantencion-api
API_ACCESS_TOKEN_MINUTES=15
API_REFRESH_TOKEN_DAYS=30
# Archivo alternativo opcional para pruebas: ENV_FILE=.env.azure-test
# En Render no se cargan archivos .env: configure los valores DB_* en el panel.
