# Copie este archivo como .env.sql-express. No suba el archivo real a Git.
# SQL Server Express privado dentro de la red local.
DB_SERVER=192.168.11.254
DB_PORT=1433
DB_NAME=ReportesMantencion
DB_USER=reportes_app
DB_PASSWORD=REEMPLACE_CON_LA_CLAVE_DEL_LOGIN_REPORTES_APP
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Genere secretos distintos y largos para el servidor Flask definitivo.
SECRET_KEY=REEMPLACE_CON_UN_SECRETO_ALEATORIO
API_TOKEN_SECRET=REEMPLACE_CON_OTRO_SECRETO_ALEATORIO

# Para el primer arranque se crea este administrador si aún no existe.
# Cambie ambos valores antes de iniciar la aplicación.
ADMIN_USERNAME=admin@maltexco.cl
ADMIN_PASSWORD=REEMPLACE_CON_LA_CLAVE_DEL_ADMINISTRADOR_INICIAL

# Durante pruebas locales los adjuntos se guardan en la carpeta uploads.
FILE_STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads

# Solo cuando Waitress esté publicado detrás de Apache como proxy inverso.
# El proceso Waitress debe escuchar exclusivamente en 127.0.0.1.
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=0
PROXY_FIX_X_PREFIX=1
